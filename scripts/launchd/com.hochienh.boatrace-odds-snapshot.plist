<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.hochienh.boatrace-odds-snapshot</string>

	<!-- 締切前賠率時系列快照迴圈（scripts/run_odds_snapshot.sh） -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>/Users/user/boatrace-predictor/scripts/run_odds_snapshot.sh</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/user/boatrace-predictor</string>

	<!-- 登入即啟動；程序因任何原因結束都自動重啟 -->
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>30</integer>

	<key>StandardOutPath</key>
	<string>/Users/user/boatrace-predictor/logs/odds_snapshot.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/user/boatrace-predictor/logs/odds_snapshot.log</string>
</dict>
</plist>
